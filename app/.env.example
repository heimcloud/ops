# Shared secret for POST /api/incidents (Bearer or X-Ops-Secret)
OPS_INGEST_SECRET=

# GitHub token for draft PR creation (OPS_GITHUB_TOKEN preferred)
OPS_GITHUB_TOKEN=
GITHUB_TOKEN=
# GH_TOKEN=

# SQLite (WAL). Container default; Neo mounts appdata → /data
OPS_DB_PATH=/data/ops.sqlite

# Comma-separated allowlist for Create PR target repos.
# Patterns: exact "owner/repo" or "owner/*". Defaults cover madebydamo/neo + heimcloud/*
OPS_TARGET_ALLOWLIST=madebydamo/neo,heimcloud/*

# Admin UI (ingest stays secret-gated; Tinyauth is at Neo SWAG edge in production)
ADMIN_ENABLED=true
ADMIN_PATH=/admin
ADMIN_READ_ONLY=false

PORT=3000
TZ=Europe/Zurich
SITE_URL=http://localhost:3000
