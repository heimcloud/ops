# Shared secret for POST /api/incidents (Bearer or X-Ops-Secret)
OPS_INGEST_SECRET=

# GitHub token for draft PR creation (GITHUB_TOKEN or GH_TOKEN)
GITHUB_TOKEN=

# SQLite (WAL). Container default; Neo mounts appdata → /data
OPS_DB_PATH=/data/ops.sqlite

# Comma-separated allowlist: exact owner/repo or owner/*
OPS_TARGET_ALLOWLIST=madebydamo/neo,heimcloud/*

ADMIN_ENABLED=true
ADMIN_PATH=/admin
ADMIN_READ_ONLY=false

PORT=3000
TZ=Europe/Zurich
SITE_URL=http://localhost:3000
